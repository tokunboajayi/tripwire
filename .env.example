# Copy to .env and put real keys THERE. Never put real keys in this file: it is public on GitHub.
SYMBOLS=BTC/USD,ETH/USD,SOL/USD
FEE_BPS=25
SLIP_BPS=5
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_PAPER_URL=https://paper-api.alpaca.markets
ANTHROPIC_API_KEY=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
VITE_AUTH0_CLIENT_ID=
# Agents → engine secret. Generate one: openssl rand -hex 24 (engine refuses to start without it unless DEV=1)
INTERNAL_TOKEN=change-me
# Only needed if the web app is served from a different origin than the engine (e.g. vite dev on :5173)
PUBLIC_ORIGIN=http://localhost:5173
# Server only: the GoDaddy domain for HTTPS via Caddy. Production: DOMAIN=getwiththeprogram.study and PUBLIC_ORIGIN=https://getwiththeprogram.study
# Leave empty on your laptop (http://localhost:8080) or for http://IP:8080
DOMAIN=
# DEV=1: name-only sign-in for local dev. NEVER on a public server: anyone could log in as anyone.
DEV=1
# GUEST_SIGNIN: name sign-in with a private random id per browser (safe on a public box, paper money only).
# Default on (works alongside Auth0). Set 0 to require Auth0.
GUEST_SIGNIN=
OWNER_USER=
DATA_DIR=./data
WEB_DIR=../web/dist
# Saved candles used if the live price feed is unreachable at boot (prices read as stale, so no new buys)
OFFLINE_FIXTURES=../backtest/fixtures
VITE_AUTH0_DOMAIN=
REGIME_MODEL=claude-sonnet-5-5
THESIS_MODEL=claude-haiku-5-5
# Optional extras
MIRROR_USER=            # e.g. auth0|abc123: this account's trades are also sent to the broker (BROKER below)
# ---- Broker (docs/08_ROADMAP.md). Paper first; live trades REAL MONEY ----
BROKER=                 # off | paper | live. Blank = paper when MIRROR_USER is set, else off
BROKER_CAPITAL_USD=     # dollars the broker may trade (required for live). Orders are scaled to it from the paper account
LIVE_MAX_ORDER_USD=     # per buy. Default 10% of capital
LIVE_MAX_DEPLOYED_USD=  # total in positions. Default = capital
LIVE_MAX_DAILY_LOSS_USD= # broker equity drop that halts new buys for the day. Default 3% of capital
LIVE_MAX_ORDERS_PER_DAY= # default 20
APCA_LIVE_KEY_ID=       # live keys are separate from the paper keys above, on purpose
APCA_LIVE_SECRET_KEY=
APCA_LIVE_URL=https://api.alpaca.markets
LIVE_CONFIRM=           # must be exactly: real-money  (BROKER=live refuses to start otherwise)
# ---- Prediction-market arbitrage: Kalshi + Polymarket (docs/08_ROADMAP.md). Paper first ----
PM_MODE=                # off | paper | live. Live = Kalshi legs only (Polymarket stays paper)
PM_PAIRS_FILE=          # watch list, default $DATA_DIR/pairs.json (example: deploy/pairs.example.json)
PM_EVERY_MS=2000        # how often every watched book is re-checked
PM_MIN_EDGE_BPS=150     # net edge after fees needed to take a set (150 = 1.5%)
PM_MAX_ARB_USD=50       # per set
PM_MAX_EXPOSURE_USD=500 # total capital tied up in open sets
PM_MAX_ARBS_PER_HOUR=30
PM_COOLDOWN_S=30        # per event, between sets
PM_PAPER_KALSHI_USD=500
PM_PAPER_POLY_USD=500
KALSHI_URL=https://api.elections.kalshi.com/trade-api/v2   # demo: https://demo-api.kalshi.co/trade-api/v2
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH= # path to the RSA private key Kalshi gave you (or KALSHI_PRIVATE_KEY with \n line breaks)
KALSHI_FEE_RATE=0.07
POLY_CLOB_URL=https://clob.polymarket.com
POLY_FEE_BPS=0
PM_LIVE_CONFIRM=        # must be exactly: real-money  (PM_MODE=live refuses to start otherwise)
ELEVENLABS_API_KEY=     # voice alerts on brain switches + AI thesis exits
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5   # cheapest/fastest; eleven_multilingual_v2 for higher quality
PRICE_EVERY_S=10        # live price refresh for the dashboard chart (trading decisions still every 60s)
REGIME_EVERY_S=900      # how often the Regime Agent calls Claude (seconds)
# Solana audit anchoring (devnet is free; fund the wallet at faucet.solana.com)
SOLANA_CLUSTER=devnet
SOLANA_KEYPAIR=        # JSON byte array of the anchor wallet; blank = auto-create agents/.solana-keypair.json
ANCHOR_EVERY_S=300
